{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug with GUI and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WAREHOUSESIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless library, CLI and tests (no SDL3)",
      "inherits": "default",
      "cacheVariables": { "WAREHOUSESIM_BUILD_GUI": "OFF" }
    },
    {
      "name": "asan",
      "displayName": "Headless with AddressSanitizer and UBSan",
      "inherits": "headless",
      "cacheVariables": { "WAREHOUSESIM_SANITIZE": "address,undefined" }
    },
    {
      "name": "tsan",
      "displayName": "Headless with ThreadSanitizer",
      "inherits": "headless",
      "cacheVariables": { "WAREHOUSESIM_SANITIZE": "thread" }
    },
    {
      "name": "tidy",
      "displayName": "Headless with clang-tidy",
      "inherits": "headless",
      "cacheVariables": { "WAREHOUSESIM_ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release with GUI and tests",
      "inherits": "default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
