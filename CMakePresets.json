{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug with GUI and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WAREHOUSESIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless library, CLI and tests (no SDL3)",
      "inherits": "default",
      "cacheVariables": { "WAREHOUSESIM_BUILD_GUI": "OFF" }
    },
    {
      "name": "asan",
      "displayName": "Headless with AddressSanitizer, UBSan and the float checks",
      "inherits": "headless",
      "cacheVariables": {
        "WAREHOUSESIM_SANITIZE": "address,undefined,float-divide-by-zero,float-cast-overflow"
      }
    },
    {
      "name": "tsan",
      "displayName": "Headless with ThreadSanitizer",
      "inherits": "headless",
      "cacheVariables": { "WAREHOUSESIM_SANITIZE": "thread" }
    },
    {
      "name": "tidy",
      "displayName": "Headless with clang-tidy",
      "inherits": "headless",
      "cacheVariables": { "WAREHOUSESIM_ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (optimised, link-time optimisation) with GUI and tests",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "release", "configurePreset": "release" },
    {
      "name": "package",
      "displayName": "Release build, then a .tar.gz (or .zip) of programs, examples and docs",
      "configurePreset": "release",
      "targets": ["package"]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 },
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 }
    }
  ]
}
